<%- include('partials/header.ejs'); -%>

<h1><%= data[0].album_name %></h1>
<div class="row">
  <div class="card">
    <h5>Wynik: <%= data[0].album_score %></h5>
    <img src="<%= data[0].album_img %>" alt="Album Image"
      style="width: 100%; height:auto;">
    <p>Uwagi : <%= data[0].album_note %></p>
  </div>
  <form action="/add/song/<%= data[0].album_id %>" method="post">
    <input type="text" name="songName" placeholder="Nazwa piosenki">
    <input type="number" name="songScore" placeholder="Ocena" max="5" min="1">
    <input type="submit" value="Dodaj utwór">
  </form>
  <% if (data[0].song_id) { %>
  <ul>
    <% data.forEach(function(song) { %>
    <li>
      <%= song.song_name %>, ocena: <%= song.song_score %>
      <form action="/delete/song/<%= song.song_id %>" method="post">
        <input type="submit" value="Usuń">
      </form>
      <form action="/edit/song/<%= song.song_id %>" method="post">
        <input type="submit" value="Edytuj">
      </form>
    </li>

    <% })}; %>

  </ul>
</div>

<%- include('partials/footer.ejs'); -%>