<%- include('partials/header.ejs'); -%>

<h1><%= album.name %></h1>
<div class="row">
    <div class="card">
      <h5>Wynik: <%= album.score %></h5>
      <img src="<%= album.img %>" alt="Album Image" style="width: 100%; height:auto;">
      <p>Uwagi : <%= album.note %></p>
	</div>
   <form action="/addsong/<%= album.id %>" method="post">
    <input type="text" name="songName" placeholder="Nazwa piosenki">
    <input type="number" name="songScore" placeholder="Ocena">
    <input type="hidden" name=albumName value= "<%= album.name %>">
    <input type="hidden" name=albumId value= "<%= album.id %>">
    <input type="hidden" name=albumNote value= "<%= album.note %>">
    <input type="hidden" name=bandId value= "<%= album.band_id %>">
    <input type="hidden" name=albumImg value= "<%= album.img %>">
    <input type="submit" value="Dodaj utwór">
</form>

<ul>
    <% songs.forEach(function(song) { %>
    <li>    
    <form action="/delete/song/<%= song.id %>" method="post">
    <%= song.name %>, ocena: <%= song.score %>
        <input type="submit" value="Usuń">
        </form>
				</li>

    <% }); %>

</ul>
</div>

<%- include('partials/footer.ejs'); -%>
