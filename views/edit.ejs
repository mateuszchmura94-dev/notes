<%- include('partials/header.ejs'); -%>
<% if (edited.band_id) { %>
<form action="/update/album/<%= edited.id %>" method="post">
  <% } else if (edited.album_id) { %>
  <form action="/update/song/<%= edited.id %>" method="post">
    <% } else { %>
    <form action="/update/<%= edited.id %>" method="post">
      <% } %>
      <% if (edited.img) { %>
      <img src="<%= edited.img %>" width="300px" height="auto" alt="img">
      <% } %>
      <input type="text" value="<%= edited.name %>" name="name">
      <input type="number" name="score" value="<%= edited.score %>">
      <% if (edited.note) { %>
      <input type="text" name="note" value="<%= edited.note %>">
      <% } %>
      <input type="submit" value="Zapisz">
    </form>
    <%- include('partials/footer.ejs'); -%>